+        /* Quarter-cycle offset so the wave starts at zero and rises, like sine. */
+        const int q = (int)(p + 0x40000000U) >> 17;
+        shape = (q < 0 ? -q : q) - 8192;
+        break;
+    }
+    case DX7_WAVE_SAW:
+        shape = (int)p >> 18;
+        break;
+    case DX7_WAVE_SQUARE:
+        shape = (int)p < 0 ? -8191 : 8191;
+        break;
+    case DX7_WAVE_HALF_SINE:
+    case DX7_WAVE_FULL_SINE: {
+        shape = mk_sin(phase, 0) / 8192;
+        if (shape < 0)
+            shape = wave == DX7_WAVE_HALF_SINE ? 0 : -shape;
+        break;
+    }
+    default:
+        return mk_sin(phase, gain);
+    }
+    if (shape > 8191) shape = 8191;
+    if (shape < -8191) shape = -8191;
+
+    const unsigned expVal = gain & 0x7fffU;
+    const int attenuation = (int)((4096U +
+        dx7_sin_exp_table[(expVal & 0x3ffU) ^ 0x3ffU]) >> (expVal >> 10));
+    return shape * attenuation;
+}
