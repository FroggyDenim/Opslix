--- /dev/null
+++ b/tools/test_sim_wave.c
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: GPL-3.0-only WITH GPL-3.0-linking-exception */
+/* End-to-end host test: drives the full open web engine through its simulator
+ * exports, plays a note on the DX7 track and checks the sim_op_wave control. */
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+extern void sim_boot(unsigned clear);
+extern int sim_select(unsigned track, unsigned source);
+extern int sim_op_wave(unsigned track, unsigned op, int wave);
+extern uint8_t *sim_file(void);
+extern int sim_midi(unsigned bytes);
+extern const float *sim_render(void);
+extern unsigned sim_block_frames(void);
+
+enum { BLOCKS = 220 };
+static int failures;
+#define CHECK(cond, ...) do { if (!(cond)) { ++failures; printf("FAIL: "); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+/* Render ~0.6 s of a held middle C. Waves: -1 leaves the engine untouched. */
+static void run(int wave, float *out)
+{
+    unsigned frames = sim_block_frames();
+    sim_boot(1 | 2);
+    CHECK(sim_select(0, 0) == 0, "select DX7 track");
+    if (wave >= 0)
+        for (unsigned op = 0; op < 6; ++op)
+            CHECK(sim_op_wave(0, op, wave) == 0, "set op %u wave %d", op, wave);
+    uint8_t *m = sim_file();
+    m[0] = 0x90; m[1] = 60; m[2] = 110;
+    CHECK(sim_midi(3) == 0, "note on");
+    for (unsigned b = 0; b < BLOCKS; ++b) {
+        const float *block = sim_render();
+        for (unsigned i = 0; i < frames; ++i) out[b * frames + i] = block[i * 2];
+    }
+}
+
+static double rms(const float *x, unsigned n)
+{
+    double s = 0;
+    for (unsigned i = 0; i < n; ++i) s += (double)x[i] * x[i];
+    return sqrt(s / n);
+}
+
+int main(void)
+{
+    static float baseline[BLOCKS * 256], saw[BLOCKS * 256], square[BLOCKS * 256], again[BLOCKS * 256];
+    unsigned n = BLOCKS * sim_block_frames();
+    run(-1, baseline);
+    run(2, saw);
+    run(3, square);
+    run(0, again);
+
+    double rb = rms(baseline, n), rs = rms(saw, n), rq = rms(square, n);
+    printf("rms: baseline %.4f  saw %.4f  square %.4f\n", rb, rs, rq);
+    CHECK(rb > 1e-4, "baseline is silent");
+    CHECK(rs > 1e-4 && rq > 1e-4, "alternate waves are silent");
+
+    unsigned same = 0;
+    for (unsigned i = 0; i < n; ++i) same += baseline[i] == again[i];
+    CHECK(same == n, "setting waves back to sine is not bit-identical (%u/%u)", same, n);
+
+    unsigned diff = 0;
+    float peak = 0;
+    for (unsigned i = 0; i < n; ++i) {
+        diff += baseline[i] != saw[i];
+        if (fabsf(saw[i]) > peak) peak = fabsf(saw[i]);
+        if (fabsf(square[i]) > peak) peak = fabsf(square[i]);
+    }
+    CHECK(diff > n / 2, "saw barely differs from sine (%u/%u)", diff, n);
+    CHECK(peak < 1.5f, "output peak %.2f", peak);
+    CHECK(sim_op_wave(0, 6, 1) < 0 && sim_op_wave(0, 0, 99) < 0 && sim_op_wave(9, 0, 1) < 0, "bad arguments accepted");
+
+    sim_boot(1 | 2);
+    sim_select(0, 0);
+    CHECK(sim_op_wave(0, 2, 4) == 0 && sim_op_wave(0, 2, -1) == 4, "wave readback");
+
+    printf(failures ? "\n%d FAILURE(S)\n" : "\nall checks passed\n", failures);
+    return failures != 0;
+}
