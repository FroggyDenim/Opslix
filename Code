+set -e
+root=$(cd "$(dirname "$0")/.." && pwd)
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+inc="-I$root/web/synth -I$root/third_party/synth -I$root/sdk/include -I$root/app/synth -I$root/app"
+common="-std=c11 -O2 -fwrapv -fno-fast-math -ffp-contract=off -DFM1_HOST_TEST -DFM1_OPEN_WEB -Wall -Wextra -Werror -Wno-unused-function -Wno-array-parameter"
+# -iquote puts the reference header ahead of the live one for that file only.
+clang $common -iquote "$root/tools/ref" $inc -Ddx7core_compute_64=ref_dx7core_compute_64 \
+    -c "$root/tools/ref/dx7core.c" -o "$tmp/ref.o"
+clang $common $inc "$root/tools/test_opwaves.c" "$root/web/synth/dx7core.c" \
+    "$root/web/synth/dx7math.c" "$root/web/synth/fixed.c" "$tmp/ref.o" -lm -o "$tmp/test"
+"$tmp/test"
+echo
+echo "== end-to-end: full web engine through the simulator exports =="
+srcs=$(git -C "$root" ls-files 'web/*.c' 'third_party/synth/*.c' 'app/*.c' | grep -v '^app/board/' | sed "s|^|$root/|")
