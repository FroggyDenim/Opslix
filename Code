--- /dev/null
+++ b/tools/test_opwaves.c
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: GPL-3.0-only WITH GPL-3.0-linking-exception */
+/* Host test for the per-operator waveforms in the open web engine.
+ *
+ *   tools/test_opwaves.sh            (builds the frozen reference core in tools/ref)
+ *
+ * Checks: (1) wave 0 is bit-exact with mk_sin, (2) every wave keeps the sine's
+ * peak level and halves per attenuation octave, (3) harmonic content matches the
+ * shape, (4) with all waves = sine the whole core is bit-identical to the
+ * original dx7core across all 32 algorithms, and (5) modulated waves stay bounded. */
+#include "engine.h"
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "dx7synth.h"
+#include "dx7core.h"
+
+/* Reference: the original core (frozen in tools/ref), compiled under another name. */
+void ref_dx7core_compute_64(int *output, int *scratch, t_dx7op_params *params,
+                            int algorithm, int *fb_buf, int feedback_shift);
+
+static int failures;
+#define CHECK(cond, ...) do { if (!(cond)) { ++failures; printf("FAIL: "); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+static unsigned rng = 12345;
+static unsigned rnd(void) { rng = rng * 1664525U + 1013904223U; return rng >> 8; }
+
+static int peak(unsigned wave, unsigned short gain)
+{
+    int best = 0;
+    for (unsigned i = 0; i < 4096; ++i) {
+        int v = mk_wave((int)(i << 12), gain, wave);
+        if (abs(v) > best) best = abs(v);
+    }
+    return best;
+}
+
+/* Render one steady operator through the real core; return harmonic magnitudes. */
+static void spectrum(unsigned wave, double mag[33], double *dc)
+{
+    t_dx7op_params params[6];
+    int out[64], scratch[64 * 3], fb[2] = {0, 0};
+    u8 waves[6] = {0, 0, 0, 0, 0, 0};
+    waves[0] = (u8)wave;
+    memset(params, 0, sizeof params);
+    for (int block = 0; block < 4; ++block) {          /* settle, then measure */
+        for (int op = 0; op < 6; ++op) { params[op].gaincur = params[op].gaindst; }
+        params[0].gaindst = (1 << 28) - (8 << 14);     /* ~full level, nonzero */
+        params[0].freq = 0x00040000;                   /* 2^24 / 64: exactly 64 samples per cycle */
+        dx7core_compute_64(out, scratch, params, 31, fb, 16, waves);
+        if (block == 0) params[0].gaincur = 8;
+    }
+    for (int k = 0; k <= 32; ++k) {
+        double re = 0, im = 0;
+        for (int n = 0; n < 64; ++n) {
+            double a = 2.0 * M_PI * k * n / 64.0;
+            re += out[n] * cos(a);
+            im -= out[n] * sin(a);
+        }
+        mag[k] = sqrt(re * re + im * im) / 32.0;
+    }
+    *dc = mag[0] / 2.0;
+}
+
+int main(void)
+{
+    /* 1. wave 0 == mk_sin */
+    for (unsigned i = 0; i < 20000; ++i) {
+        int phase = (int)(rnd() << 8 ^ rnd());
+        unsigned short gain = (unsigned short)(rnd() & 0x3fff);
+        CHECK(mk_wave(phase, gain, 0) == mk_sin(phase, gain), "wave0 != sine");
+    }
+
+    /* 2. peak level and attenuation */
+    int ref = peak(0, 0);
+    for (unsigned w = 1; w < DX7_WAVE_COUNT; ++w) {
+        int p0 = peak(w, 0), p1 = peak(w, 1024);
+        double rel = (double)p0 / ref, oct = (double)p1 / p0;
+        printf("wave %u: peak %.3f of sine, one octave of attenuation -> %.3f\n", w, rel, oct);
+        CHECK(rel > 0.95 && rel < 1.01, "wave %u peak %.3f", w, rel);
+        CHECK(oct > 0.48 && oct < 0.52, "wave %u octave ratio %.3f", w, oct);
+    }
+
+    /* 3. harmonic content through the real core */
+    double m[33], dc;
+    spectrum(DX7_WAVE_SINE, m, &dc);
+    CHECK(m[1] > 1000 * m[2] && m[1] > 1000 * m[3], "sine not pure");
+    spectrum(DX7_WAVE_SAW, m, &dc);
+    printf("saw: H2/H1=%.3f H3/H1=%.3f\n", m[2] / m[1], m[3] / m[1]);
+    CHECK(fabs(m[2] / m[1] - 0.5) < 0.05 && fabs(m[3] / m[1] - 1.0 / 3) < 0.05, "saw harmonics");
+    spectrum(DX7_WAVE_SQUARE, m, &dc);
+    printf("square: H2/H1=%.3f H3/H1=%.3f\n", m[2] / m[1], m[3] / m[1]);
+    CHECK(m[2] / m[1] < 0.02 && fabs(m[3] / m[1] - 1.0 / 3) < 0.05, "square harmonics");
+    spectrum(DX7_WAVE_TRIANGLE, m, &dc);
+    printf("triangle: H2/H1=%.3f H3/H1=%.3f\n", m[2] / m[1], m[3] / m[1]);
+    CHECK(m[2] / m[1] < 0.02 && fabs(m[3] / m[1] - 1.0 / 9) < 0.02, "triangle harmonics");
+    spectrum(DX7_WAVE_HALF_SINE, m, &dc);
+    printf("half sine: H2/H1=%.3f\n", m[2] / m[1]);
+    CHECK(fabs(m[2] / m[1] - 0.4244) < 0.05, "half-sine harmonics");
+    spectrum(DX7_WAVE_FULL_SINE, m, &dc);
+    printf("full sine: H1/H2=%.4f\n", m[1] / m[2]);
+    CHECK(m[1] / m[2] < 0.02, "full-wave sine keeps a fundamental");
+
+    /* 4. all-sine core is bit-identical to the original, every algorithm */
+    unsigned compared = 0;
+    for (int alg = 0; alg < 32; ++alg) {
+        for (int trial = 0; trial < 40; ++trial) {
+            t_dx7op_params a[6], b[6];
+            int oa[64], ob[64], sa[192], sb[192], fa[2] = {0, 0}, fb[2] = {0, 0};
+            u8 waves[6] = {0, 0, 0, 0, 0, 0};
+            int shift = (rnd() & 1) ? 16 : (int)(rnd() % 8);
+            for (int op = 0; op < 6; ++op) {
+                a[op].gaincur = (int)(rnd() % 16000) + 1;
+                a[op].gaindst = (int)(rnd() % (1 << 28));
+                a[op].freq = (int)(rnd() << 8 ^ rnd()) >> 3;
+                a[op].phase = (int)(rnd() << 8 ^ rnd());
+                b[op] = a[op];
+            }
+            for (int blk = 0; blk < 3; ++blk) {
+                dx7core_compute_64(oa, sa, a, alg, fa, shift, waves);
+                ref_dx7core_compute_64(ob, sb, b, alg, fb, shift);
+                CHECK(memcmp(oa, ob, sizeof oa) == 0, "alg %d trial %d block %d differs", alg + 1, trial, blk);
+                CHECK(memcmp(a, b, sizeof a) == 0 && memcmp(fa, fb, sizeof fa) == 0,
+                      "alg %d state differs", alg + 1);
+                ++compared;
+            }
+        }
+    }
+    printf("bit-exact blocks vs original core: %u\n", compared);
+
+    /* 5. modulated non-sine waves stay finite and move with the modulator */
+    for (unsigned w = 1; w < DX7_WAVE_COUNT; ++w) {
+        t_dx7op_params p[6];
+        int o1[64], o2[64], s[192], fb[2] = {0, 0};
+        u8 waves[6] = {(u8)w, (u8)w, 0, 0, 0, 0};
+        memset(p, 0, sizeof p);
+        for (int op = 0; op < 2; ++op) { p[op].gaincur = 8; p[op].gaindst = (1 << 28) - (8 << 14); }
+        p[0].freq = 0x00040000; p[1].freq = 0x00040000 * 2;
+        dx7core_compute_64(o1, s, p, 4, fb, 16, waves);        /* alg 5: op0 -> op1 */
+        memset(p, 0, sizeof p);
+        for (int op = 0; op < 2; ++op) { p[op].gaincur = 8; p[op].gaindst = (1 << 28) - (8 << 14); }
+        p[0].freq = 0x00040000; p[1].freq = 0x00040000 * 2;
+        memset(fb, 0, sizeof fb);
+        waves[0] = 0;                                          /* different modulator shape */
+        dx7core_compute_64(o2, s, p, 4, fb, 16, waves);
+        int differ = 0, big = 0;
+        for (int i = 0; i < 64; ++i) { differ |= o1[i] != o2[i]; if (abs(o1[i]) > (1 << 27)) big = 1; }
+        CHECK(differ, "wave %u: modulator shape has no effect", w);
+        CHECK(!big, "wave %u: output exceeds range", w);
+    }
+
+    printf(failures ? "\n%d FAILURE(S)\n" : "\nall checks passed\n", failures);
+    return failures != 0;
+}
